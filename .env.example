APP_NAME=Dharmik Foods API
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
DATABASE_BACKEND=mongodb
DATABASE_NAME=DharmicFoods
# MongoDB replica-set or Atlas connection URI. Never commit credentials.
MONGODB_URI=
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same key in the warehouse .env.local.
WAREHOUSE_API_KEY=

# Google OAuth web application; keep the client secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Local uploads work without cloud credentials. Switch to azure when configured.
MEDIA_STORAGE=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_MEDIA_CONTAINER=dharmik-foods-media
# Public delivery base URL including the container; HTTPS, no SAS secret.
AZURE_MEDIA_PUBLIC_BASE_URL=
